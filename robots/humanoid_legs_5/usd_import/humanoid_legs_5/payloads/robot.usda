#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "humanoid_legs_5"
    doc = """Generated from Composed Stage of root layer /antioch/renderer-cache/tmp/tmpusyao5h0/humanoid_legs_5.usdc


