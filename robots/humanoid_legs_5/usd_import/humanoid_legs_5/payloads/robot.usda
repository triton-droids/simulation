                                }
                            }

                            over "left_ankle_crank" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "left_ankle_crank_joint" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "right_leg1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_hip1_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "right_leg2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_hip2_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "right_leg3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_thigh_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "right_leg4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_knee_joint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }

                            over "right_foot" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "right_ankle_joint" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
                                )
                                {
                                }

                                over "right_heel_linkage" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "right_heel_bar_joint" (
                                        prepend apiSchemas = ["IsaacJointAPI"]
