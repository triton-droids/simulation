{
  "version": 1,
  "output_dir": "results/gate4_corrective/C20_randomized_queue",
  "max_wall_seconds": 5400,
  "jobs": [
    {
      "id": "C20_randomized",
      "hypothesis": "Test whether the nominal full-command gait already recovers from randomized initial states before allocating recovery training.",
      "evidence": "C20 passes all8 nominal command gates and combined-command video. Earlier lineage needed randomized-reset training, so evaluate this lineage first.",
      "stages": [
        {
          "id": "evaluate",
          "argv": [
            "source/scripts/evaluate_g1.py",
            "--run-dir",
            "results/gate4_corrective/C20_linear18_seed7_1003520",
            "--checkpoint",
            "1003520",
            "--reference-label",
            "initial",
            "--steps",
            "500",
            "--seeds",
            "5000,5001",
            "--randomized-reset",
            "--commands",
            "stand",
            "forward",
            "backward",
            "left",
            "right",
            "turn_left",
            "turn_right",
            "combined",
            "--video",
            "--video-command",
            "combined",
            "--output-dir",
            "results/gate4_corrective/C20_randomized_gate"
          ],
          "fresh_paths": [
            "results/gate4_corrective/C20_randomized_gate"
          ],
          "required_paths": [
            "results/gate4_corrective/C20_randomized_gate/summary.json",
            "results/gate4_corrective/C20_randomized_gate/episodes.csv",
            "results/gate4_corrective/C20_randomized_gate/trained_combined_seed5000.mp4"
          ],
          "timeout_seconds": 5400
        }
      ],
      "episodes_csv": "results/gate4_corrective/C20_randomized_gate/episodes.csv",
      "gate": {
        "horizon": 500,
        "controllers": [
          "trained",
          "initial",
          "standing"
        ],
        "commands": [
          "stand",
          "forward",
          "backward",
          "left",
          "right",
          "turn_left",
          "turn_right",
          "combined"
        ],
        "seeds": [
          5000,
          5001
        ],
        "outcomes": {
          "pass": [
            {
              "name": "all16 survive500",
              "aggregate": "min",
              "metric": "episode_steps",
              "min": 500
            },
            {
              "name": "upright pelvis",
              "aggregate": "min",
              "metric": "minimum_pelvis_height",
              "above": 0.6
            },
            {
              "name": "mean linear_velocity_vector_rmse",
              "aggregate": "mean",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.25
            },
            {
              "name": "worst linear_velocity_vector_rmse",
              "aggregate": "max",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.35
            },
            {
              "name": "mean yaw_rate_rmse",
              "aggregate": "mean",
              "metric": "yaw_rate_rmse",
              "max": 0.25
            },
            {
              "name": "worst yaw_rate_rmse",
              "aggregate": "max",
              "metric": "yaw_rate_rmse",
              "max": 0.35
            }
          ]
        }
      }
    }
  ]
}
