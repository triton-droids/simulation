{
  "version": 1,
  "output_dir": "results/gate4_corrective/C19_queue",
  "max_wall_seconds": 14400,
  "jobs": [
    {
      "id": "C19",
      "hypothesis": "The corrected seed7 gait can acquire full commanded velocities while retaining yaw control, using audited variance priors for previously constant command channels.",
      "evidence": "C18 passed nominal/visual and fixed1.5Hz gait/yaw checks. C12 established the unseen-command normalization failure and exact-parity prior preparation; reuse that verified transition with retained yawweight9.",
      "stages": [
        {
          "id": "prepare",
          "argv": [
            "source/scripts/prepare_g1_command_prior.py",
            "--run-dir",
            "results/gate4_corrective/C18_yaw9_seed7_1003520",
            "--checkpoint",
            "1003520",
            "--lateral-std",
            "0.16431676725154984",
            "--yaw-std",
            "0.27386127875258304",
            "--output-dir",
            "results/gate4_corrective/C19_command_prior"
          ],
          "fresh_paths": [
            "results/gate4_corrective/C19_command_prior"
          ],
          "required_paths": [
            "results/gate4_corrective/C19_command_prior/audit.json",
            "results/gate4_corrective/C19_command_prior/checkpoint/policy"
          ],
          "timeout_seconds": 1200
        },
        {
          "id": "train",
          "argv": [
            "source/scripts/train.py",
            "--logger",
            "local",
            "--seed",
            "7",
            "--resume",
            "--checkpoint",
            "{root}/results/gate4_corrective/C19_command_prior/checkpoint",
            "env=unitree_g1_playground",
            "robot=unitree_g1",
            "sim=unitree_g1_playground",
            "agent=ppo_g1_corrective",
            "robot.fetch_model=false",
            "sim.playground.fetch_source=false",
            "sim.reset.randomize=false",
            "sim.noise.add_noise=false",
            "sim.push.add_push=false",
            "sim.domain_rand.add_domain_rand=false",
            "sim.commands.lin_vel_x=[-0.3,0.6]",
            "sim.commands.lin_vel_y=[-0.3,0.3]",
            "sim.commands.ang_vel_yaw=[-0.5,0.5]",
            "sim.reward_scales.tracking_lin_vel=3.0",
            "sim.reward_scales.tracking_ang_vel=9.0",
            "sim.reward_scales.feet_phase=3.0",
            "sim.reward_scales.feet_contact_phase=2.0",
            "agent.num_timesteps=2007040",
            "agent.num_evals=8",
            "agent.num_eval_envs=16",
            "agent.episode_length=500",
            "hydra.run.dir={root}/results/gate4_corrective/C19_commands_seed7_2007040",
            "hydra.job.chdir=true"
          ],
          "fresh_paths": [
            "results/gate4_corrective/C19_commands_seed7_2007040"
          ],
          "required_paths": [
            "results/gate4_corrective/C19_commands_seed7_2007040/run_manifest.json",
            "results/gate4_corrective/C19_commands_seed7_2007040/logs/checkpoints/0/policy",
            "results/gate4_corrective/C19_commands_seed7_2007040/logs/checkpoints/2007040/policy"
          ],
          "timeout_seconds": 7200,
          "monitor": {
            "path": "results/gate4_corrective/C19_commands_seed7_2007040/logs/metrics.jsonl",
            "ignore_kl_through_step": 286720,
            "consecutive_kl_limit": 2,
            "kl_limit": 0.2,
            "final_step": 2007040
          }
        },
        {
          "id": "restore_audit",
          "argv": [
            "-c",
            "from brax.io import model;import jax,numpy as np,json;from pathlib import Path;a=model.load_params(Path('results/gate4_corrective/C19_command_prior/checkpoint/policy'));b=model.load_params(Path('results/gate4_corrective/C19_commands_seed7_2007040/logs/checkpoints/0/policy'));la,ta=jax.tree_util.tree_flatten(a);lb,tb=jax.tree_util.tree_flatten(b);ok=ta==tb and len(la)==len(lb) and all(np.array_equal(np.asarray(x),np.asarray(y)) for x,y in zip(la,lb));f=open('results/gate4_corrective/C19_commands_seed7_2007040/restore_parity.json','x');json.dump(dict(exact_actor_normalizer_match=ok,leaves=len(la)),f);f.close();assert ok,'Warm-start parity failed'"
          ],
          "fresh_paths": [
            "results/gate4_corrective/C19_commands_seed7_2007040/restore_parity.json"
          ],
          "required_paths": [
            "results/gate4_corrective/C19_commands_seed7_2007040/restore_parity.json"
          ],
          "timeout_seconds": 600
        },
        {
          "id": "evaluate",
          "argv": [
            "source/scripts/evaluate_g1.py",
            "--run-dir",
            "results/gate4_corrective/C19_commands_seed7_2007040",
            "--checkpoint",
            "2007040",
            "--reference-label",
            "initial",
            "--steps",
            "500",
            "--seeds",
            "4000",
            "--nominal-reset",
            "--commands",
            "stand",
            "forward",
            "backward",
            "left",
            "right",
            "turn_left",
            "turn_right",
            "combined",
            "--video",
            "--video-command",
            "combined",
            "--output-dir",
            "results/gate4_corrective/C19_command_gate"
          ],
          "fresh_paths": [
            "results/gate4_corrective/C19_command_gate"
          ],
          "required_paths": [
            "results/gate4_corrective/C19_command_gate/summary.json",
            "results/gate4_corrective/C19_command_gate/episodes.csv",
            "results/gate4_corrective/C19_command_gate/trained_combined_seed4000.mp4"
          ],
          "timeout_seconds": 5400
        }
      ],
      "episodes_csv": "results/gate4_corrective/C19_command_gate/episodes.csv",
      "gate": {
        "horizon": 500,
        "controllers": [
          "trained",
          "initial",
          "standing"
        ],
        "commands": [
          "stand",
          "forward",
          "backward",
          "left",
          "right",
          "turn_left",
          "turn_right",
          "combined"
        ],
        "seeds": [
          4000
        ],
        "outcomes": {
          "pass": [
            {
              "name": "all episodes survive500",
              "aggregate": "min",
              "metric": "episode_steps",
              "min": 500
            },
            {
              "name": "upright pelvis",
              "aggregate": "min",
              "metric": "minimum_pelvis_height",
              "above": 0.6
            },
            {
              "name": "mean linear error",
              "aggregate": "mean",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.25
            },
            {
              "name": "mean yaw error",
              "aggregate": "mean",
              "metric": "yaw_rate_rmse",
              "max": 0.2
            },
            {
              "name": "forward linear",
              "where": {
                "command_name": "forward"
              },
              "aggregate": "max",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.25
            },
            {
              "name": "backward linear",
              "where": {
                "command_name": "backward"
              },
              "aggregate": "max",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.25
            },
            {
              "name": "left linear",
              "where": {
                "command_name": "left"
              },
              "aggregate": "max",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.25
            },
            {
              "name": "right linear",
              "where": {
                "command_name": "right"
              },
              "aggregate": "max",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.25
            },
            {
              "name": "combined linear",
              "where": {
                "command_name": "combined"
              },
              "aggregate": "max",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.25
            },
            {
              "name": "turn_left yaw",
              "where": {
                "command_name": "turn_left"
              },
              "aggregate": "max",
              "metric": "yaw_rate_rmse",
              "max": 0.25
            },
            {
              "name": "turn_right yaw",
              "where": {
                "command_name": "turn_right"
              },
              "aggregate": "max",
              "metric": "yaw_rate_rmse",
              "max": 0.25
            },
            {
              "name": "stand linear_velocity_vector_rmse",
              "where": {
                "command_name": "stand"
              },
              "aggregate": "max",
              "metric": "linear_velocity_vector_rmse",
              "max": 0.15
            },
            {
              "name": "stand yaw_rate_rmse",
              "where": {
                "command_name": "stand"
              },
              "aggregate": "max",
              "metric": "yaw_rate_rmse",
              "max": 0.15
            },
            {
              "name": "forward single_support_fraction",
              "where": {
                "command_name": "forward"
              },
              "aggregate": "min",
              "metric": "single_support_fraction",
              "min": 0.35,
              "max": 0.95
            },
            {
              "name": "forward left_median_completed_air_seconds",
              "where": {
                "command_name": "forward"
              },
              "aggregate": "min",
              "metric": "left_median_completed_air_seconds",
              "min": 0.12
            },
            {
              "name": "forward right_median_completed_air_seconds",
              "where": {
                "command_name": "forward"
              },
              "aggregate": "min",
              "metric": "right_median_completed_air_seconds",
              "min": 0.12
            }
          ]
        }
      }
    }
  ]
}
