            "-c",
            "from brax.io import model;import jax,numpy as np,json;from pathlib import Path;a=model.load_params(Path('results/gate4_corrective/C17_gait_seed7_2007040/logs/checkpoints/2007040/policy'));b=model.load_params(Path('results/gate4_corrective/C18_yaw9_seed7_1003520/logs/checkpoints/0/policy'));la,ta=jax.tree_util.tree_flatten(a);lb,tb=jax.tree_util.tree_flatten(b);ok=ta==tb and len(la)==len(lb) and all(np.array_equal(np.asarray(x),np.asarray(y)) for x,y in zip(la,lb));f=open('results/gate4_corrective/C18_yaw9_seed7_1003520/restore_parity.json','x');json.dump(dict(exact_actor_normalizer_match=ok,leaves=len(la)),f);f.close();assert ok,'Warm-start parity failed'"
