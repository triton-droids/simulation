{
  "version": 1,
  "output_dir": "Artifacts/Results/cluster_rp03_p100/queue",
  "max_wall_seconds": 1800,
  "jobs": [
    {
      "id": "source",
      "review_artifact": "Artifacts/Results/cluster_rp03_p100/source.json",
      "stages": [
        {
          "id": "fetch_pinned",
          "argv": [
            "-c",
            "from robocub.locomotion.unitree_g1.playground_source import resolve_playground_source;from pathlib import Path;import json;s=resolve_playground_source(fetch=True);p=Path('Artifacts/Results/cluster_rp03_p100/source.json');p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps({'source':str(s)}))"
          ],
          "fresh_paths": [
            "Artifacts/Results/cluster_rp03_p100/source.json"
          ],
          "required_paths": [
            "Artifacts/Results/cluster_rp03_p100/source.json"
          ],
          "timeout_seconds": 300
        }
      ],
      "hypothesis": "Prepare pinned source for P100 recovery capability probe",
      "evidence": "Original RTX node administratively drained; no bypass authorized."
    },
    {
      "id": "p100_capability",
      "hypothesis": "Existing runtime executes official simulator reproducibly on Slurm-assigned P100 before checkpoint continuation.",
      "evidence": "RTX node drained; scheduler P100 test-only accepted. GPU numerical equivalence unproven.",
      "review_artifact": "Artifacts/Results/cluster_rp03_p100/comparison.json",
      "stages": [
        {
          "id": "probe_a",
          "argv": [
            "robocub/scripts/evaluate_g1.py",
            "--run-dir",
            "{root}/../../RB07_101/source/Artifacts/Results/cluster_rb07_101/train",
            "--checkpoint",
            "94617600",
            "--steps",
            "20",
            "--seeds",
            "6000",
            "--commands",
            "stand",
            "--nominal-reset",
            "--output-dir",
            "Artifacts/Results/cluster_rp03_p100/a",
            "--save-numeric-traces"
          ],
          "fresh_paths": [
            "Artifacts/Results/cluster_rp03_p100/a"
          ],
          "required_paths": [
            "Artifacts/Results/cluster_rp03_p100/a/summary.json",
            "Artifacts/Results/cluster_rp03_p100/a/numeric_traces/trained_stand_seed6000.npz"
          ],
          "timeout_seconds": 700
        },
        {
          "id": "probe_b",
          "argv": [
            "robocub/scripts/evaluate_g1.py",
            "--run-dir",
            "{root}/../../RB07_101/source/Artifacts/Results/cluster_rb07_101/train",
            "--checkpoint",
            "94617600",
            "--steps",
            "20",
            "--seeds",
            "6000",
            "--commands",
            "stand",
            "--nominal-reset",
            "--output-dir",
            "Artifacts/Results/cluster_rp03_p100/b",
            "--save-numeric-traces"
          ],
          "fresh_paths": [
            "Artifacts/Results/cluster_rp03_p100/b"
          ],
          "required_paths": [
            "Artifacts/Results/cluster_rp03_p100/b/summary.json",
            "Artifacts/Results/cluster_rp03_p100/b/numeric_traces/trained_stand_seed6000.npz"
          ],
          "timeout_seconds": 700
        },
        {
          "id": "compare",
          "argv": [
            "-c",
            "from pathlib import Path;import numpy as np,json;from robocub.utils.trace_reproducibility import compare_traces;p=Path('Artifacts/Results/cluster_rp03_p100');r={n:compare_traces(dict(np.load(p/'a'/'numeric_traces'/n)),dict(np.load(p/'b'/'numeric_traces'/n))) for n in ['trained_stand_seed6000.npz','untrained_stand_seed6000.npz','standing_stand_seed6000.npz']};(p/'comparison.json').write_text(json.dumps(r,indent=2));assert all(v['exact'] for v in r.values()),'P100 repeatability failed'"
          ],
          "fresh_paths": [
            "Artifacts/Results/cluster_rp03_p100/comparison.json"
          ],
          "required_paths": [
            "Artifacts/Results/cluster_rp03_p100/comparison.json"
          ],
          "timeout_seconds": 60
        }
      ]
    }
  ]
}
