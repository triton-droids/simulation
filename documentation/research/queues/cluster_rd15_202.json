{
  "version": 1,
  "output_dir": "Artifacts/Results/cluster_rd15_202/queue",
  "max_wall_seconds": 3600,
  "jobs": [
    {
      "id": "source",
      "review_artifact": "Artifacts/Results/cluster_rd15_202/source.json",
      "stages": [
        {
          "id": "fetch_pinned",
          "argv": [
            "-c",
            "from robocub.locomotion.unitree_g1.playground_source import resolve_playground_source;from pathlib import Path;import json;s=resolve_playground_source(fetch=True);p=Path('Artifacts/Results/cluster_rd15_202/source.json');p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps({'source':str(s)}))"
          ],
          "fresh_paths": [
            "Artifacts/Results/cluster_rd15_202/source.json"
          ],
          "required_paths": [
            "Artifacts/Results/cluster_rd15_202/source.json"
          ],
          "timeout_seconds": 300
        }
      ],
      "hypothesis": "Prepare pinned source for signed standing yaw diagnostic",
      "evidence": "All RB06 seeds fail standing yaw with high single support; RMSE alone cannot distinguish sustained bias from alternating motion."
    },
    {
      "id": "stand_trace",
      "hypothesis": "Discriminate sustained directional standing-yaw bias from alternating motion; no intervention.",
      "evidence": "All RB06 seeds fail standing yaw with high single support; RMSE alone cannot distinguish sustained bias from alternating motion.",
      "review_artifact": "Artifacts/Results/cluster_rd15_202/evaluation/summary.json",
      "stages": [
        {
          "id": "official_stand",
          "argv": [
            "robocub/scripts/evaluate_g1.py",
            "--run-dir",
            "{root}/../../RB06_202r1/source/Artifacts/Results/cluster_rb06_202r1/train",
            "--checkpoint",
            "20070400",
            "--steps",
            "500",
            "--seeds",
            "6000",
            "--commands",
            "stand",
            "--nominal-reset",
            "--output-dir",
            "Artifacts/Results/cluster_rd15_202/evaluation",
            "--save-numeric-traces",
            "--video",
            "--video-command",
            "stand"
          ],
          "fresh_paths": [
            "Artifacts/Results/cluster_rd15_202/evaluation"
          ],
          "required_paths": [
            "Artifacts/Results/cluster_rd15_202/evaluation/summary.json",
            "Artifacts/Results/cluster_rd15_202/evaluation/episodes.csv",
            "Artifacts/Results/cluster_rd15_202/evaluation/numeric_traces/trained_stand_seed6000.npz",
            "Artifacts/Results/cluster_rd15_202/evaluation/trained_stand_seed6000.mp4"
          ],
          "timeout_seconds": 2400
        }
      ]
    }
  ]
}
